# Rehberim video otomasyonu yapılandırması.
# Bu dosyayı "config.env" adıyla kopyala ve doldur (config.env git'e girmez).

# --- NotebookLM oturumu (bir kez 'notebooklm login' ile üretilen dosya) ---
NOTEBOOKLM_STORAGE=/path/to/storage_state.json

# Video ayarları: önceki videolarla aynı stil.
VIDEO_STYLE=classic          # auto|classic|whiteboard|kawaii|anime|watercolor|retro-print|heritage|paper-craft|custom
VIDEO_FORMAT=explainer       # explainer|brief
VIDEO_LANGUAGE=tr
VIDEO_PARALLEL=3             # aynı anda kaç üretim
VIDEO_HEIGHT=720             # sıkıştırma çözünürlüğü (720 önerilir)
VIDEO_CRF=26                 # kalite (düşük = daha iyi/daha büyük)

# --- Depo: s3 (Cloudflare R2 / Bunny / AWS), supabase veya local ---
STORAGE_BACKEND=s3

# s3 / Cloudflare R2
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=rehberim-videolar
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=videolar
PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev   # veya kendi alan adın

# supabase (alternatif)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=videolar
