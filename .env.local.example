# --- Supabase (ücretsiz) ---
# https://supabase.com → New project → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Gemini (ücretsiz) ---
# https://aistudio.google.com/apikey → Create API key
GEMINI_API_KEY=

# Gemini modeli (varsayılan: gemini-2.5-flash — ücretsiz katmanda çalışır)
GEMINI_MODEL=gemini-2.5-flash

# Uygulama temel URL'si (OAuth yönlendirmeleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
